#!/usr/bin/env python3
"""
vc520-ports - enable the LAN switches and I354 ports on a VeloCloud Edge 520
running Debian 12 / Turnium SD-WAN.

Hardware map (verified on a VC520) and interface names set by this tool:
  eth0  I350 04:00.0          SFP1  (GE1 RJ45 copper: not working yet)
  eth1  I350 04:00.1          SFP2  (GE2 RJ45 copper: not working yet)
  eth2  I354 00:14.1  <- 88E6176 switch B port 4 SerDes <- LAN1-LAN4 (switch B ports 0-3)
        switch B is on 00:14.1's OWN MDIO bus (MDICNFG 0x80000000)
  eth3  I354 00:14.0  <- 88E6176 switch A port 4 SerDes <- LAN5-LAN8 (switch A ports 0-3)
        switch A is on the SHARED I354 MDIO bus (MDICNFG 0xc0000000)
  eth4  I354 00:14.2  (no front port found)
  --    I354 00:14.3  left UNBOUND as management path to switch A
Names are applied by PCI address after binding (two-phase rename), so they do not
depend on probe order.

Problems this fixes at boot:
  1. igb fails on the I354 ports ("probe failed with error -2", "MDI Error"):
     NVM says SGMII + external PHY, but the ports connect straight to switch SerDes.
     Fix: set CTRL_EXT link mode to 1000BASE-KX (no PHY needed) before binding.
  2. Both 88E6176 come out of reset with all ports Disabled and all PHYs + SerDes
     powered down (VeloCloud firmware normally enables them).
     Fix: power them up and set every port to Forwarding (unmanaged switch;
     802.1Q tags pass through unchanged, so eth2.<vid> / eth3.<vid> work).

Linux blocks register access to a PCI function owned by igb, so a switch can only be
managed through an UNBOUND I354 port wired to its MDIO bus. Switch B's only known
path is 00:14.1 (= eth2); 'status --force' briefly unbinds eth2 to read it.

Config: /etc/default/vc520-ports
"""
import argparse, mmap, os, struct, sys, time, syslog

VERSION = "0.3.0"
DEV = "/sys/bus/pci/devices/0000:00:14.{}"
IGB = "/sys/bus/pci/drivers/igb"
I350_PORT0 = "/sys/bus/pci/devices/0000:04:00.0"
I354_ID = ("0x8086", "0x1f41")
SWITCH_ID_MASK, SWITCH_ID = 0xFFF0, 0x1760          # 88E6176 (0x1761 = rev 1)

CTRL_EXT, MDIC, MDICNFG = 0x18, 0x20, 0x0E04
LINK_MODE_MASK, LINK_MODE_KX, I2C_ENA = 0x00C00000, 0x00400000, 0x02000000
MDICNFG_SHARED = 0xC0000000                          # external + common MDIO
G1, G2 = 0x1B, 0x1C

DEFAULTS = {
    "BIND_FNS": "1 0 2",
    # final interface names by PCI address (applied after binding, any boot order)
    "NAMES": "0000:04:00.0=eth0 0000:04:00.1=eth1 0000:00:14.1=eth2 0000:00:14.0=eth3 0000:00:14.2=eth4",
    # name:fn:MDICNFG  - the I354 port whose MDIO bus reaches the switch
    "SWITCHES": "A:0:0xc0000000 B:1:0x80000000",
    # alternate management path used once the switch's own port is bound
    "SWITCH_MGMT": "A:3:0xc0000000",
    "LABELS_A": "0:LAN6 1:LAN-A1 2:LAN-A2 3:LAN-A3 4:uplink-eth3 5:rgmii5 6:rgmii6",
    "LABELS_B": "0:LAN-B0 1:LAN-B1 2:LAN-B2 3:LAN-B3 4:uplink-eth2 5:rgmii5 6:rgmii6",
}


def log(msg, err=False):
    print(msg, file=sys.stderr if err else sys.stdout, flush=True)
    try:
        syslog.syslog(syslog.LOG_ERR if err else syslog.LOG_INFO, msg)
    except Exception:
        pass


def die(msg):
    log("ERROR: " + msg, err=True)
    sys.exit(1)


def h(v):
    return "----" if v is None else f"{v:04x}"


def bit(v, n, w=1):
    return "?" if v is None else (v >> n) & ((1 << w) - 1)


# ---------------------------------------------------------------- config
class Cfg:
    def __init__(self):
        raw = dict(DEFAULTS)
        path = "/etc/default/vc520-ports"
        if os.path.exists(path):
            for line in open(path):
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    raw[k.strip()] = v.strip().strip('"').strip("'")
        self.bind = [int(x) for x in raw["BIND_FNS"].split()]
        self.switches = self._paths(raw["SWITCHES"])
        self.mgmt = self._paths(raw.get("SWITCH_MGMT", ""))
        self.names = []
        for item in raw.get("NAMES", "").split():
            bdf, n = item.split("=")
            self.names.append((bdf if bdf.startswith("0000:") else "0000:" + bdf, n))
        self.labels = {}
        for name in self.switches:
            lab = {p: f"port{p}" for p in range(7)}
            for item in raw.get(f"LABELS_{name}", "").split():
                if ":" in item:
                    p, l = item.split(":", 1)
                    lab[int(p)] = l
            self.labels[name] = lab
        for name, (fn, _) in self.mgmt.items():
            if fn in self.bind:
                die(f"SWITCH_MGMT {name} uses 00:14.{fn}, which is also in BIND_FNS")

    @staticmethod
    def _paths(s):
        out = {}
        for item in s.split():
            name, fn, cfg = item.split(":")
            out[name] = (int(fn), int(cfg, 16))
        return out

    def mdicnfg_for(self, fn):
        for d in (self.switches, self.mgmt):
            for f, c in d.values():
                if f == fn:
                    return c
        return MDICNFG_SHARED


# ---------------------------------------------------------------- PCI helpers
def is_bound(fn):
    return os.path.exists(DEV.format(fn) + "/driver")


def netdev(fn):
    try:
        return os.listdir(DEV.format(fn) + "/net")[0]
    except (FileNotFoundError, IndexError):
        return None


class Bar:
    """Direct BAR0 register access to an UNBOUND I354 function."""

    def __init__(self, fn):
        if is_bound(fn):
            raise RuntimeError(f"00:14.{fn} is bound to igb; registers not accessible")
        self.fd = os.open(DEV.format(fn) + "/resource0", os.O_RDWR | os.O_SYNC)
        self.m = mmap.mmap(self.fd, 0x20000)

    def rd(self, o):
        return struct.unpack_from("<I", self.m, o)[0]

    def wr(self, o, v):
        struct.pack_into("<I", self.m, o, v)

    def close(self):
        self.m.close()
        os.close(self.fd)


def set_mdicnfg(fn, val):
    b = Bar(fn)
    b.wr(MDICNFG, val)
    b.close()


class Switch:
    """88E6176 in single-chip mode, via an I354 MDIO master (clause 22)."""

    def __init__(self, fn, mdicnfg):
        self.fn = fn
        self.bar = Bar(fn)
        self.cfg0 = mdicnfg
        self.bar.wr(MDICNFG, mdicnfg)

    def smi(self, addr, reg, val=None):
        b = self.bar
        op = 1 if val is not None else 2
        for _ in range(10):
            b.wr(MDICNFG, (self.cfg0 & ~0x03E00000) | (addr << 21))
            b.wr(MDIC, (reg << 16) | (addr << 21) | (op << 26) | ((val or 0) & 0xFFFF))
            for _ in range(2000):
                v = b.rd(MDIC)
                if v & (1 << 28):
                    break
            else:
                continue
            if v & (1 << 30):
                time.sleep(0.001)
                continue
            return v & 0xFFFF
        return None

    def g2wait(self):
        for _ in range(200):
            v = self.smi(G2, 0x18)
            if v is not None and not v & 0x8000:
                return

    def phy_rd(self, dev, reg):
        self.g2wait()
        self.smi(G2, 0x18, 0x9800 | (dev << 5) | reg)
        self.g2wait()
        return self.smi(G2, 0x19)

    def phy_wr(self, dev, reg, val):
        self.g2wait()
        self.smi(G2, 0x19, val)
        self.smi(G2, 0x18, 0x9400 | (dev << 5) | reg)
        self.g2wait()

    def ok(self):
        i = self.smi(0x10, 3)
        return i is not None and i & SWITCH_ID_MASK == SWITCH_ID

    def close(self):
        self.bar.wr(MDICNFG, self.cfg0)
        self.bar.close()


def open_switch(cfg, name, force=False):
    """Return (Switch, rebind_fn) or (None, reason). rebind_fn is set if we unbound a port."""
    paths = [cfg.switches[name]]
    if name in cfg.mgmt:
        paths.insert(0, cfg.mgmt[name])
    for fn, mc in paths:
        if not is_bound(fn):
            sw = Switch(fn, mc)
            if sw.ok():
                return sw, None
            sw.close()
    if force:
        fn, mc = cfg.switches[name]
        if is_bound(fn):
            with open(IGB + "/unbind", "w") as f:
                f.write(f"0000:00:14.{fn}")
            sw = Switch(fn, mc)
            if sw.ok():
                return sw, fn
            sw.close()
            return None, fn
    return None, None


# ---------------------------------------------------------------- hw checks
def check_hw():
    for fn in range(4):
        d = DEV.format(fn)
        try:
            ids = (open(d + "/vendor").read().strip(), open(d + "/device").read().strip())
        except FileNotFoundError:
            die(f"00:14.{fn} not present - is this a VeloCloud Edge 520?")
        if ids != I354_ID:
            die(f"00:14.{fn} is {ids}, expected Intel I354 {I354_ID}")


def wait_for_igb(timeout=60):
    t0 = time.time()
    if not os.path.isdir(IGB):
        os.system("modprobe igb")
    while time.time() - t0 < timeout:
        if os.path.isdir(IGB) and (not os.path.exists(I350_PORT0)
                                   or os.path.exists(I350_PORT0 + "/driver")):
            return
        time.sleep(1)
    log("WARNING: igb did not bind the I350 within timeout; continuing", err=True)


# ---------------------------------------------------------------- actions
def switch_up(sw):
    for p in range(5):                                  # copper PHYs
        sw.phy_wr(p, 22, 0)
        r16 = sw.phy_rd(p, 16)
        if r16 is not None and r16 & 0x0004:             # copper-specific power-down
            sw.phy_wr(p, 16, r16 & ~0x0004)
        r0 = sw.phy_rd(p, 0)
        if r0 is not None:
            sw.phy_wr(p, 0, (r0 & ~0x0800) | 0x8000)     # clear BMCR PDOWN + soft reset
    sw.phy_wr(0x0F, 22, 1)                               # SerDes, page 1
    r0 = sw.phy_rd(0x0F, 0)
    if r0 is not None:
        sw.phy_wr(0x0F, 0, (r0 & ~0x0800) | 0x8000)
    sw.phy_wr(0x0F, 22, 0)
    for p in range(7):                                   # all ports -> Forwarding
        c = sw.smi(0x10 + p, 4)
        if c is not None and c & 3 != 3:
            sw.smi(0x10 + p, 4, (c & ~3) | 3)


def bind_kx(fn, mdicnfg):
    if is_bound(fn):
        return netdev(fn), "already bound"
    b = Bar(fn)
    ce = b.rd(CTRL_EXT)
    b.wr(CTRL_EXT, (ce & ~(LINK_MODE_MASK | I2C_ENA)) | LINK_MODE_KX)
    b.wr(MDICNFG, mdicnfg)
    b.close()
    try:
        with open(IGB + "/bind", "w") as f:
            f.write(f"0000:00:14.{fn}")
    except OSError as e:
        return None, f"bind failed: {e}"
    for _ in range(20):
        n = netdev(fn)
        if n:
            return n, "bound (1000BASE-KX)"
        time.sleep(0.1)
    return None, "bound but no netdev"


def run(*cmd):
    import subprocess
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(f"{' '.join(cmd)}: {r.stderr.strip()}")


def pci_netdev(bdf):
    try:
        return os.listdir(f"/sys/bus/pci/devices/{bdf}/net")[0]
    except (FileNotFoundError, IndexError):
        return None


def is_up(ifname):
    try:
        return int(open(f"/sys/class/net/{ifname}/flags").read(), 16) & 1 == 1
    except FileNotFoundError:
        return False


def apply_names(cfg):
    """Rename interfaces to NAMES (by PCI address). Two-phase, so swaps like eth2<->eth3 work."""
    todo = []
    for bdf, want in cfg.names:
        cur = pci_netdev(bdf)
        if cur and cur != want:
            todo.append((bdf, cur, want))
    if not todo:
        return
    targets = {w for _, _, w in todo}
    moving = {c for _, c, _ in todo}
    for _, _, w in todo:                      # move unrelated holders of target names aside
        if os.path.exists(f"/sys/class/net/{w}") and w not in moving:
            n = 5
            while os.path.exists(f"/sys/class/net/eth{n}") or f"eth{n}" in targets:
                n += 1
            was = is_up(w)
            run("ip", "link", "set", w, "down")
            run("ip", "link", "set", w, "name", f"eth{n}")
            if was:
                run("ip", "link", "set", f"eth{n}", "up")
            log(f"renamed {w} -> eth{n} (not in NAMES, moved aside)")
    state = {}
    for i, (bdf, cur, want) in enumerate(todo):
        state[bdf] = is_up(cur)
        run("ip", "link", "set", cur, "down")
        run("ip", "link", "set", cur, "name", f"vc520tmp{i}")
    for i, (bdf, cur, want) in enumerate(todo):
        run("ip", "link", "set", f"vc520tmp{i}", "name", want)
        if state[bdf]:
            run("ip", "link", "set", want, "up")
        log(f"renamed {cur} -> {want} ({bdf})")


def cmd_up(args):
    check_hw()
    cfg = Cfg()
    wait_for_igb()
    # management-only ports must be unbound (e.g. igb grabbed them after a warm reboot)
    for fn in range(4):
        if fn not in cfg.bind and is_bound(fn):
            with open(IGB + "/unbind", "w") as f:
                f.write(f"0000:00:14.{fn}")
            log(f"00:14.{fn}: unbound (reserved for switch management)")
    # pin each unbound port's MDIO routing (warm reboots keep stale values)
    for fn in range(4):
        if not is_bound(fn):
            set_mdicnfg(fn, cfg.mdicnfg_for(fn))
    for name in cfg.switches:
        sw, rebind = open_switch(cfg, name, force=True)
        if not sw:
            log(f"switch {name}: NOT reachable - not enabled", err=True)
        else:
            try:
                switch_up(sw)
                log(f"switch {name}: enabled via 00:14.{sw.fn}")
            finally:
                sw.close()
        if rebind is not None:
            n, msg = bind_kx(rebind, cfg.mdicnfg_for(rebind))
            log(f"00:14.{rebind}: {n or '-'} {msg}", err=n is None)
    for fn in cfg.bind:
        n, msg = bind_kx(fn, cfg.mdicnfg_for(fn))
        log(f"00:14.{fn}: {n or '-'} {msg}", err=n is None)
        if n:
            os.system(f"ip link set {n} up")
    try:
        apply_names(cfg)
    except RuntimeError as e:
        log(f"ERROR renaming interfaces: {e}", err=True)
    for bdf, want in cfg.names:
        log(f"  {bdf} -> {pci_netdev(bdf) or '-'}")
    return 0


SPD = {0: "10M", 1: "100M", 2: "1G", 3: "?"}
STATE = {0: "disabled", 1: "blocking", 2: "learning", 3: "forwarding"}


def print_switch(sw, name, labels, detail):
    print(f"\nSwitch {name} (via 00:14.{sw.fn})  ID={h(sw.smi(0x10, 3))}")
    print(f"  {'PORT':5}{'FRONT':14}{'LINK':6}{'SPEED':7}{'DUPLEX':8}STATE")
    for p in range(7):
        s, c4 = sw.smi(0x10 + p, 0), sw.smi(0x10 + p, 4)
        if s is None:
            print(f"  {p:<5}{labels[p]:14}read error")
            continue
        up = s >> 11 & 1
        note = "  (forced link)" if p in (5, 6) else ""
        print(f"  {p:<5}{labels[p]:14}{'UP' if up else 'down':6}"
              f"{SPD[s >> 8 & 3] if up else '-':7}"
              f"{('full' if s >> 10 & 1 else 'half') if up else '-':8}"
              f"{STATE.get(c4 & 3, '?') if c4 is not None else '?'}{note}")
    if detail:
        for p in range(5):
            r0 = sw.phy_rd(p, 0)
            sw.phy_rd(p, 1)
            r1 = sw.phy_rd(p, 1)
            print(f"  phy{p}: ctl={h(r0)} sts={h(r1)} pwrdn={bit(r0, 11)} link={bit(r1, 2)}")
        sw.phy_wr(0x0F, 22, 1)
        r0 = sw.phy_rd(0x0F, 0)
        sw.phy_rd(0x0F, 1)
        r1 = sw.phy_rd(0x0F, 1)
        sw.phy_wr(0x0F, 22, 0)
        print(f"  serdes: ctl={h(r0)} sts={h(r1)} pwrdn={bit(r0, 11)} link={bit(r1, 2)}")


def cmd_status(args):
    check_hw()
    cfg = Cfg()
    print(f"vc520-ports {VERSION}")
    for fn in range(4):
        print(f"  00:14.{fn}: {'bound -> ' + str(netdev(fn)) if is_bound(fn) else 'unbound'}")
    for name in cfg.switches:
        sw, rebind = open_switch(cfg, name, force=args.force)
        if not sw:
            print(f"\nSwitch {name}: not reachable"
                  + ("" if args.force else " (its port is bound; use --force to briefly unbind it)"))
        else:
            try:
                print_switch(sw, name, cfg.labels[name], args.detail)
            finally:
                sw.close()
        if rebind is not None:
            n, msg = bind_kx(rebind, cfg.mdicnfg_for(rebind))
            if n:
                os.system(f"ip link set {n} up")
            try:
                apply_names(cfg)
            except RuntimeError as e:
                log(f"ERROR renaming interfaces: {e}", err=True)
            print(f"  (rebound 00:14.{rebind} -> {pci_netdev('0000:00:14.%d' % rebind)}: {msg})")
    return 0


def cmd_watch(args):
    cfg = Cfg()
    name = args.switch
    sw, _ = open_switch(cfg, name)
    if not sw:
        die(f"switch {name} not reachable while its port is bound")
    lab = cfg.labels[name]
    last = None
    print(f"watching switch {name} PHY link (Ctrl-C to stop)")
    try:
        while True:
            st = []
            for p in range(4):
                r17 = sw.phy_rd(p, 17)
                up = r17 not in (None, 0xFFFF) and r17 & 0x400
                st.append(f"{lab[p]}:{SPD[r17 >> 14 & 3] if up else '--'}")
            line = "  ".join(st)
            if line != last:
                print(time.strftime("%T"), line, flush=True)
                last = line
            time.sleep(1)
    except KeyboardInterrupt:
        pass
    finally:
        sw.close()
    return 0


def main():
    if os.geteuid() != 0:
        die("must run as root")
    ap = argparse.ArgumentParser(description="VeloCloud Edge 520 LAN switch / I354 enablement")
    ap.add_argument("--version", action="version", version=VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("up", help="enable switches and bind I354 ports (boot-time)").set_defaults(f=cmd_up)
    p = sub.add_parser("status", help="port/link table for both switches")
    p.add_argument("--force", action="store_true",
                   help="briefly unbind a switch's uplink port to read it (drops its LANs ~2s)")
    p.add_argument("--detail", action="store_true", help="also show PHY/SerDes registers")
    p.set_defaults(f=cmd_status)
    p = sub.add_parser("watch", help="live PHY link monitor")
    p.add_argument("switch", nargs="?", default="A", help="A (default) or B")
    p.set_defaults(f=cmd_watch)
    args = ap.parse_args()
    sys.exit(args.f(args))


if __name__ == "__main__":
    main()
