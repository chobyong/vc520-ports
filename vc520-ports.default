# /etc/default/vc520-ports  (vc520-ports 0.2.x)

# I354 functions (00:14.N) to bind to igb, in order -> eth2, eth3, eth4
#   0 = switch A uplink (LAN5-LAN8)   1 = switch B uplink (LAN1-LAN4)   2 = unused
BIND_FNS="0 1 2"

# Switches  name:I354-fn:MDICNFG   (fn whose MDIO bus reaches that switch)
SWITCHES="A:0:0xc0000000 B:1:0x80000000"

# Management path while the switch's own port is bound (must be an UNBOUND fn).
# Switch A is on the shared bus, so 00:14.3 reaches it. No alternate known for B.
SWITCH_MGMT="A:3:0xc0000000"

# Front-panel labels per switch port (fill in as mapped; 4 = SerDes uplink)
LABELS_A="0:LAN6 1:LAN-A1 2:LAN-A2 3:LAN-A3 4:uplink-eth2 5:rgmii5 6:rgmii6"
LABELS_B="0:LAN-B0 1:LAN-B1 2:LAN-B2 3:LAN-B3 4:uplink-eth3 5:rgmii5 6:rgmii6"
